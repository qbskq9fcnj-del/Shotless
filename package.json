{
  "name": "shotless",
  "version": "0.1.0",
  "description": "ショートカットで全画面を撮影し、クリップボードにだけ入れるアプリ。画像ファイルは保存しません。",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.shotless.app",
    "productName": "Shotless",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/flash.html",
      "src/settings.html",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": "nsis"
    },
    "asarUnpack": [
      "node_modules/active-win/**/*"
    ]
  },
  "dependencies": {
    "active-win": "^7.7.2"
  }
}
