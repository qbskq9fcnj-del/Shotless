{
  "name": "shotless",
  "version": "1.0.0",
  "description": "ショートカットで全画面を撮影し、クリップボードにだけ入れるアプリ。画像ファイルは保存しません。",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.17.0",
    "typescript": "^5.6.0"
  },
  "build": {
    "appId": "com.shotless.app",
    "productName": "Shotless",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/flash.html",
      "src/settings.html",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "LSUIElement": true
      },
      "icon": "build/Shotless.icon",
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
